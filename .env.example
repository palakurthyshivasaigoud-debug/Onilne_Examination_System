FLASK_SECRET_KEY=super-secret-key-change-in-production-2024
FLASK_DEBUG=True

# MySQL Database (XAMPP default settings)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=exam_system

# Gmail SMTP (use App Password, not your real password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Upload folder for proctoring screenshots
UPLOAD_FOLDER=static/screenshots
